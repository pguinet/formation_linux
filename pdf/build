#!/usr/bin/env bash
# Point d'entrée unique de la génération des PDF, en local comme en CI.
#
#   ./pdf/build                        PDF puis tests
#   ./pdf/build pdf [FICHIER.pdf ...]  PDF seuls (tous, ou ceux indiqués)
#   ./pdf/build test [ARGS ...]        tests seuls (arguments passés à pytest)
#   ./pdf/build check                  lint : ruff et shellcheck
#   ./pdf/build shell [COMMANDE ...]   shell (ou commande) dans l'image
set -euo pipefail

commande="${1:-tout}"
if [ $# -gt 0 ]; then shift; fi

# Commande inconnue : aide, sans construire l'image.
case "$commande" in
    tout | pdf | test | check | shell) ;;
    *)
        sed -n '2,8p' "$0" >&2
        exit 2
        ;;
esac

racine="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
image="formation-linux-pdf"
date_source="$(git -C "$racine" log -1 --format=%ct 2>/dev/null || date +%s)"

docker build --quiet --tag "$image" "$racine/pdf" > /dev/null

options_tty=()
dans_image() {
    docker run --rm \
        --user "$(id -u):$(id -g)" \
        --env HOME=/tmp \
        --env PYTHONDONTWRITEBYTECODE=1 \
        --env RUFF_NO_CACHE=true \
        --env SOURCE_DATE_EPOCH="$date_source" \
        --env FORCE_SOURCE_DATE=1 \
        --volume "$racine:/data" \
        --workdir /data \
        "${options_tty[@]}" \
        "$image" "$@"
}

case "$commande" in
    tout)
        dans_image python3 pdf/generer.py
        dans_image python3 -m pytest pdf/tests
        ;;
    pdf)
        dans_image python3 pdf/generer.py "$@"
        ;;
    test)
        if [ $# -eq 0 ] || [[ "$1" == -* ]]; then set -- pdf/tests "$@"; fi
        dans_image python3 -m pytest "$@"
        ;;
    check)
        dans_image ruff check pdf
        dans_image ruff format --check pdf
        dans_image shellcheck pdf/build
        ;;
    shell)
        options_tty=(--interactive)
        if [ -t 0 ]; then options_tty+=(--tty); fi
        if [ $# -eq 0 ]; then set -- bash; fi
        dans_image "$@"
        ;;
esac
